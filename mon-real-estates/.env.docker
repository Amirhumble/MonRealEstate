# Docker Environment Variables
# Copy this file to .env and update with your production values

# Database Configuration
MONGODB_CONNECTION_URL=mongodb://admin:password@mongodb:27017/monrealestate?authSource=admin
MONGO_USERNAME=admin
MONGO_PASSWORD=your_secure_mongodb_password

# JWT Configuration
JWT_SECRET=your_super_secure_64_character_jwt_secret_key_here_replace_this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
CONTACT_EMAIL=your_contact_email@gmail.com